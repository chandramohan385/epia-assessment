# Server Configuration
PORT=3000
NODE_ENV=development

# Database path (optional, defaults to ./epia_patients.db)
DB_PATH=./epia_patients.db

# AI API Keys (Optional - System automatically falls back to Mock AI if keys are omitted)
# For Google Gemini API:
GEMINI_API_KEY=

# For OpenAI API (alternative):
OPENAI_API_KEY=
